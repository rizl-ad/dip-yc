# !!! DO NOT EDIT THIS FILE !!!
# This file is generated from the yc-prep Terraform project
# To configure Terraform providers create another file

terraform {
  backend "s3" {
    endpoints = {
      s3 = "https://storage.yandexcloud.net"
      dynamodb = "${doc_api_endpoint}"
    }

    dynamodb_table = "${dynamodb_teble_name}"
    
    shared_credentials_files = ["${aws_access_file_path}"]
    profile = "${profile}"
    region = "${region}"
    bucket = "${bucket_name}"
    key = "terraform.tfstate"

    skip_region_validation = true
    skip_credentials_validation = true
    skip_requesting_account_id = true # This option is required for Terraform 1.6.1 or higher.
    skip_s3_checksum = true # This option is required to describe a backend for Terraform 1.6.3 or higher.
  }
}