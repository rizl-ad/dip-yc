# !!! DO NOT EDIT THIS FILE !!!
# This file is generated from the yc-prep Terraform project
# To configure Ansible inventory create another file

all:
%{ if global_vars != null ~}
  vars:
%{ for key, value in global_vars ~}
    ${key}: "${value}"
%{ endfor ~}
%{ endif ~}

  children:
%{ for group, vms in vms_data ~}
    ${group}:
      hosts:
%{ for vm in vms.hosts ~}
        ${vm.name}:
          ansible_host: ${vm.ip}
%{ endfor ~}
%{ if vms.vars != null ~}
      vars:
%{ for key, value in vms.vars ~}
        ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
%{ endfor ~}
